# NestWall environment template — from spec Appendix C.
# Copy to .env and replace every placeholder. Never commit .env.

# Host port that opens NestWall in a browser. The default is an uncommon port to avoid clashes. Change it if needed.
# APP_URL must use the same port, for example http://192.168.1.20:5842.
WEB_PORT=5842

# Public address of the app, including the port. Emailed password reset links are built from it.
APP_URL=http://localhost:5842

# Database: one SQLite file, encrypted with SQLCipher.
# The file is written to database/nestwall.db in the repo root (compose sets DB_PATH).
# DB_KEY is the passphrase that opens the file. Keep a backup copy somewhere safe:
# without it the data cannot be read. Use a long random value with no single quotes.
DB_KEY=change-me-long-random-passphrase

# Session signing secret (generate with: openssl rand -base64 48)
SESSION_SECRET=change-me

# Deployment
TZ=America/Toronto