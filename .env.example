# NestWall configuration template.
# Copy this file to .env and replace the placeholder values. Never commit .env (it is git-ignored).
#   - Building from source (docker compose -f deploy/compose.yaml): save the copy as deploy/.env
#   - Published images (docker compose -f compose.release.yaml): save the copy next to compose.release.yaml
# Do not put quotes around values.

# Required

# Passphrase that encrypts the family database (SQLCipher). Use at least 24 random characters.
# Without it the data cannot be opened, so keep a copy somewhere safe, outside the repo.
DB_KEY=change-me-long-random-passphrase

# Secret that signs sign-in sessions. Use at least 48 random characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-long-random-secret

# Optional

# Address of the app in the browser, including the port. Password reset emails link to it.
# On a home network use the host's LAN address, for example http://192.168.1.20:5842.
APP_URL=http://localhost:5842

# Port on this computer that opens NestWall. Keep APP_URL on the same port.
WEB_PORT=5842

# Time zone of the family. Scheduled backups run at the saved hour in this zone.
TZ=America/Toronto

# Image version to run (compose.release.yaml only). "latest" follows the newest release.
# Pin a version such as 1.0.0 to upgrade only when you choose to.
NESTWALL_VERSION=latest